DATABASE_URL="postgresql://postgres:<password>@<project>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@<project>.pooler.supabase.com:5432/postgres"
JWT_SECRET="replace-with-a-long-random-string"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="GreenCharge <no-reply@mail.greencharge.space>"
PORT=4000
NODE_ENV=development
# Shared secret an external free cron (e.g. cron-job.org) sends as the x-cron-secret
# header to POST /api/v1/internal/run-booking-jobs every minute, so booking reminders
# and auto-cancels still run while Render's free plan has put the app to sleep.
CRON_SECRET="replace-with-a-long-random-string"
