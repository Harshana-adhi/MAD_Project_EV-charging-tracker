generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  owner
  admin
}

enum ConnectorType {
  TYPE1
  TYPE2
  CCS2
  CHADEMO
  GBT
}

enum StationStatus {
  pending
  approved
  rejected
  hidden
  deleted
}

enum ChargerStatus {
  available
  busy
  offline
  walkin
}

enum SessionStatus {
  active
  completed
  cancelled
  disputed
}

enum TxnType {
  topup
  hold
  release
  charge
  earning
  commission
  withdrawal
}

enum TopupMethod {
  card
  slip
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum WithdrawalStatus {
  pending
  paid
  rejected
}

enum BookingStatus {
  booked
  cancelled
  expired
  used
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  phone         String?
  role          Role           @default(customer)
  isBlocked     Boolean        @default(false) @map("is_blocked")
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  wallet        Wallet?
  vehicles      Vehicle[]
  stations      Station[]
  sessions      Session[]
  topups        TopupRequest[]
  withdrawals   Withdrawal[]
  reviews       Review[]
  favourites    Favourite[]
  notifications Notification[]
  bookings      Booking[]
  @@map("users")
}

model Vehicle {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  makeModel  String        @map("make_model")
  connector  ConnectorType
  batteryKwh Decimal?      @map("battery_kwh") @db.Decimal(6, 1)
  createdAt  DateTime      @default(now()) @map("created_at")
  @@map("vehicles")
}

model Station {
  id           String        @id @default(uuid())
  ownerId      String        @map("owner_id")
  owner        User          @relation(fields: [ownerId], references: [id])
  name         String
  description  String?
  address      String
  lat          Float
  lng          Float
  openingHours String        @map("opening_hours")
  amenities    String[]      @default([])
  photos       String[]      @default([])
  status       StationStatus @default(pending)
  rejectReason String?       @map("reject_reason")
  createdAt    DateTime      @default(now()) @map("created_at")
  chargers     Charger[]
  sessions     Session[]
  reviews      Review[]
  favourites   Favourite[]
  bookings     Booking[]
  @@index([status])
  @@map("stations")
}

model Charger {
  id         String        @id @default(uuid())
  stationId  String        @map("station_id")
  station    Station       @relation(fields: [stationId], references: [id], onDelete: Cascade)
  label      String
  connector  ConnectorType
  powerKw    Decimal       @map("power_kw") @db.Decimal(6, 1)
  ratePerKwh Decimal       @map("rate_per_kwh") @db.Decimal(10, 2)
  status     ChargerStatus @default(available)
  busyUntil  DateTime?     @map("busy_until")
  qrToken    String        @unique @map("qr_token")
  createdAt  DateTime      @default(now()) @map("created_at")
  sessions   Session[]
  bookings   Booking[]
  @@map("chargers")
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String?       @unique @map("user_id")
  // A user's wallet holds real credits, so the user cannot be deleted while it exists.
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Exactly one wallet is the platform's (enforced by a partial unique index in the migration).
  isPlatform   Boolean       @default(false) @map("is_platform")
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  held         Decimal       @default(0) @db.Decimal(12, 2)
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]
  @@map("wallets")
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String   @map("wallet_id")
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  type      TxnType
  amount    Decimal  @db.Decimal(12, 2)
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([walletId, createdAt])
  @@map("transactions")
}

model TopupRequest {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     TopupMethod
  slipUrl    String?       @map("slip_url")
  status     RequestStatus @default(pending)
  reason     String?
  reviewedBy String?       @map("reviewed_by")
  createdAt  DateTime      @default(now()) @map("created_at")
  @@map("topup_requests")
}

model Session {
  id            String        @id @default(uuid())
  customerId    String        @map("customer_id")
  customer      User          @relation(fields: [customerId], references: [id])
  chargerId     String        @map("charger_id")
  charger       Charger       @relation(fields: [chargerId], references: [id])
  stationId     String        @map("station_id")
  station       Station       @relation(fields: [stationId], references: [id])
  spendingLimit Decimal       @map("spending_limit") @db.Decimal(12, 2)
  // The charger's rate when the session started. Billing uses this, not the charger's rate today.
  ratePerKwh    Decimal?      @map("rate_per_kwh") @db.Decimal(10, 2)
  kwh           Decimal?      @db.Decimal(8, 2)
  cost          Decimal?      @db.Decimal(12, 2)
  commission    Decimal?      @db.Decimal(12, 2)
  status        SessionStatus @default(active)
  disputeReason String?       @map("dispute_reason")
  startedAt     DateTime      @default(now()) @map("started_at")
  endedAt       DateTime?     @map("ended_at")
  review        Review?
  @@index([customerId])
  @@index([chargerId, status])
  @@map("sessions")
}

model Withdrawal {
  id          String           @id @default(uuid())
  ownerId     String           @map("owner_id")
  owner       User             @relation(fields: [ownerId], references: [id])
  amount      Decimal          @db.Decimal(12, 2)
  bankNote    String           @map("bank_note")
  status      WithdrawalStatus @default(pending)
  processedBy String?          @map("processed_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  @@map("withdrawals")
}

model Review {
  id         String   @id @default(uuid())
  stationId  String   @map("station_id")
  station    Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id")
  customer   User     @relation(fields: [customerId], references: [id])
  sessionId  String   @unique @map("session_id")
  session    Session  @relation(fields: [sessionId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  @@map("reviews")
}

model Favourite {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId String   @map("station_id")
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@id([userId, stationId])
  @@map("favourites")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  refId     String?  @map("ref_id")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, read])
  @@map("notifications")
}

model Booking {
  id             String        @id @default(uuid())
  customerId     String        @map("customer_id")
  customer       User          @relation(fields: [customerId], references: [id])
  chargerId      String        @map("charger_id")
  charger        Charger       @relation(fields: [chargerId], references: [id])
  stationId      String        @map("station_id")
  station        Station       @relation(fields: [stationId], references: [id])
  startAt        DateTime      @map("start_at") @db.Timestamptz(3)
  endAt          DateTime      @map("end_at") @db.Timestamptz(3)
  status         BookingStatus @default(booked)
  sessionId      String?       @map("session_id")
  reminderSentAt DateTime?     @map("reminder_sent_at")
  warningSentAt  DateTime?     @map("warning_sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  cancelledAt    DateTime?     @map("cancelled_at")
  @@index([chargerId, startAt])
  @@index([customerId, status])
  @@map("bookings")
}

// Live-update events each backend instance writes so other instances (other developers'
// local backends sharing this database) can pass them on to their own connected phones.
model RealtimeEvent {
  id        Int      @id @default(autoincrement())
  event     String
  payload   Json
  userId    String?  @map("user_id")
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@map("realtime_events")
}
