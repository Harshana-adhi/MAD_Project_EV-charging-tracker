{
  "info": {
    "name": "EV Charge Tracker - Profile, Vehicles & Admin (M2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": ""
    },
    {
      "key": "stationId",
      "value": ""
    },
    {
      "key": "topupId",
      "value": ""
    },
    {
      "key": "withdrawalId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@evct.lk\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@evct.lk\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('customerToken', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@evct.lk\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('ownerToken', body.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile"
          }
        },
        {
          "name": "P-01 Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Customer One Updated\",\n  \"phone\": \"0771234567\"\n}"
            }
          }
        },
        {
          "name": "P-02 Invalid phone (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"12345\"\n}"
            }
          }
        },
        {
          "name": "Clear phone",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Create vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"makeModel\": \"Nissan Leaf\",\n  \"connector\": \"TYPE2\",\n  \"batteryKwh\": 40\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('vehicleId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List vehicles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/vehicles"
          }
        },
        {
          "name": "Update vehicle",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batteryKwh\": 62\n}"
            }
          }
        },
        {
          "name": "Invalid battery (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"makeModel\": \"Tiny Car\",\n  \"connector\": \"TYPE1\",\n  \"batteryKwh\": 5\n}"
            }
          }
        },
        {
          "name": "Owner cannot use vehicles (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/vehicles"
          }
        },
        {
          "name": "P-03 Delete with unknown id (404)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/vehicles/00000000-0000-4000-8000-000000000000"
          }
        },
        {
          "name": "Delete vehicle",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          }
        }
      ]
    },
    {
      "name": "Admin - dashboard and users",
      "item": [
        {
          "name": "Get counts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/counts"
          }
        },
        {
          "name": "P-12 Owner calls counts (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/counts"
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users?search=customer2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data.length > 0) pm.collectionVariables.set('userId', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "P-11 Block user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/block",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blocked\": true\n}"
            }
          }
        },
        {
          "name": "Unblock user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/block",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blocked\": false\n}"
            }
          }
        },
        {
          "name": "Reset user password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Short password (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"short\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin - stations",
      "item": [
        {
          "name": "List pending stations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/stations?status=pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data.length > 0) pm.collectionVariables.set('stationId', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "P-07 Reject without reason (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/stations/{{stationId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": false\n}"
            }
          }
        },
        {
          "name": "P-08 Approve station",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/stations/{{stationId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true\n}"
            }
          }
        },
        {
          "name": "Approve station again (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/stations/{{stationId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true\n}"
            }
          }
        },
        {
          "name": "List approved stations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/stations?status=approved"
          }
        }
      ]
    },
    {
      "name": "Admin - slip top-ups",
      "item": [
        {
          "name": "List pending top-ups",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/topups?status=pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data.length > 0) pm.collectionVariables.set('topupId', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "P-05 Approve top-up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/topups/{{topupId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true\n}"
            }
          }
        },
        {
          "name": "P-06 Approve top-up again (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/topups/{{topupId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true\n}"
            }
          }
        },
        {
          "name": "Reject top-up with reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/topups/{{topupId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": false,\n  \"reason\": \"Slip amount does not match the request\"\n}"
            }
          }
        },
        {
          "name": "Customer wallet after approval",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/wallet"
          }
        }
      ]
    },
    {
      "name": "Admin - withdrawals",
      "item": [
        {
          "name": "List pending withdrawals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/withdrawals?status=pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data.length > 0) pm.collectionVariables.set('withdrawalId', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "P-09 Mark withdrawal as paid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/process",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true\n}"
            }
          }
        },
        {
          "name": "P-10 Reject withdrawal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/process",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": false\n}"
            }
          }
        },
        {
          "name": "Process again (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/process",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true\n}"
            }
          }
        },
        {
          "name": "Owner wallet after processing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/wallet"
          }
        }
      ]
    }
  ]
}
