{
  "info": {
    "name": "EV Charge Tracker - Auth, Wallet & Stations (M1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "stationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"newcustomer@evct.lk\",\n  \"password\": \"Password123\",\n  \"fullName\": \"New Customer\",\n  \"role\": \"customer\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@evct.lk\",\n  \"password\": \"Password123\"\n}"
        }
      }
    },
    {
      "name": "Get Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "Get Wallet",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/wallet"
      }
    },
    {
      "name": "Top Up (success)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/wallet/topup",
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 500,\n  \"cardNumber\": \"4242424242424242\"\n}" }
      }
    },
    {
      "name": "Top Up (declined)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/wallet/topup",
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 500,\n  \"cardNumber\": \"4000000000000002\"\n}" }
      }
    },
    {
      "name": "List Stations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.length) pm.collectionVariables.set('stationId', body.data[0].id);"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/stations" }
    },
    {
      "name": "List Stations (filtered)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/stations?connector=CCS2&availableOnly=true&lat=7.2906&lng=80.6337",
          "host": ["{{baseUrl}}"],
          "path": ["stations"],
          "query": [
            { "key": "connector", "value": "CCS2" },
            { "key": "availableOnly", "value": "true" },
            { "key": "lat", "value": "7.2906" },
            { "key": "lng", "value": "80.6337" }
          ]
        }
      }
    },
    {
      "name": "Get Station",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/stations/{{stationId}}"
      }
    },
    {
      "name": "Get Station (not found)",
      "request": { "method": "GET", "url": "{{baseUrl}}/stations/00000000-0000-0000-0000-000000000000" }
    }
  ]
}
