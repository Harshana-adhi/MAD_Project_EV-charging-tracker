{
  "info": {
    "name": "Member 5 Charging Sessions",
    "description": "Run with a seeded approved charger and authenticated customer. Set baseUrl, customerToken, qrToken, and kwh. The requests are ordered for the normal start/end flow; negative cases use separate variables and may require owner/admin setup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Look up charger",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test(\"Charger details\", () => { pm.expect(data.charger.qrToken).to.eql(pm.collectionVariables.get(\"qrToken\")); pm.expect(data.available).to.be.a(\"number\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/charger/{{qrToken}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "charger",
            "{{qrToken}}"
          ]
        }
      }
    },
    {
      "name": "02 Start session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test(\"Active session\", () => { pm.expect(data.status).to.eql(\"active\"); pm.expect(data.spendingLimit).to.eql(500); });",
              "pm.collectionVariables.set(\"sessionId\", data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "start"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qrToken\": \"{{qrToken}}\",\n  \"spendingLimit\": 500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Read active session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test(\"Same active session\", () => pm.expect(data.id).to.eql(pm.collectionVariables.get(\"sessionId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/active",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "active"
          ]
        }
      }
    },
    {
      "name": "04 Read session history",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test(\"History includes current session\", () => pm.expect(data.some((s) => s.id === pm.collectionVariables.get(\"sessionId\"))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions"
          ]
        }
      }
    },
    {
      "name": "05 Read session detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test(\"Names and rate present\", () => { pm.expect(data.stationName).to.be.a(\"string\"); pm.expect(data.ratePerKwh).to.be.a(\"number\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}"
          ]
        }
      }
    },
    {
      "name": "06 End session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test(\"Completed and capped\", () => { pm.expect(data.status).to.eql(\"completed\"); pm.expect(data.cost).to.be.at.most(data.spendingLimit); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/end",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}",
            "end"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kwh\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 End twice is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"No double charge\", () => pm.expect(pm.response.json().error.code).to.eql(\"SESSION_NOT_ACTIVE\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/end",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}",
            "end"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kwh\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Active is null after end",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No active session\", () => pm.expect(pm.response.json().data).to.be.null);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/active",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "active"
          ]
        }
      }
    },
    {
      "name": "09 Start session to cancel",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"cancelSessionId\", pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "start"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qrToken\": \"{{qrToken}}\",\n  \"spendingLimit\": 500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Cancel releases hold",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Cancelled\", () => pm.expect(pm.response.json().data.status).to.eql(\"cancelled\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{cancelSessionId}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{cancelSessionId}}",
            "cancel"
          ]
        }
      }
    },
    {
      "name": "11 Insufficient balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 402\", () => pm.response.to.have.status(402));",
              "pm.test(\"Balance rejected\", () => pm.expect(pm.response.json().error.code).to.eql(\"INSUFFICIENT_BALANCE\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "start"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qrToken\": \"{{qrToken}}\",\n  \"spendingLimit\": 20000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 Unknown charger",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Unknown charger\", () => pm.expect(pm.response.json().error.code).to.eql(\"CHARGER_NOT_FOUND\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/charger/unknownqr123",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "charger",
            "unknownqr123"
          ]
        }
      }
    },
    {
      "name": "13 Invalid spending limit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Input rejected\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "start"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qrToken\": \"{{qrToken}}\",\n  \"spendingLimit\": 99\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "14 Other customer cannot read session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"Ownership enforced\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_ALLOWED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherCustomerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}"
          ]
        }
      }
    },
    {
      "name": "15 Other customer cannot end session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"Ownership enforced\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_ALLOWED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherCustomerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/end",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}",
            "end"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kwh\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "otherCustomerToken",
      "value": ""
    },
    {
      "key": "qrToken",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "cancelSessionId",
      "value": ""
    },
    {
      "key": "kwh",
      "value": "3"
    }
  ]
}
